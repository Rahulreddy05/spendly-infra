# API secrets. Copy to secrets.env (git-ignored): cp secrets.example.env secrets.env
# Generate values with: openssl rand -base64 48
DATABASE_URL=postgresql://spendly:change-me@spendly-db:5432/spendly?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32 — encrypts 2FA secrets and bank tokens at rest
DATA_ENCRYPTION_KEY=
# SMTP connection URL (contains credentials, so it is a secret)
SMTP_URL=
# Plaid SANDBOX keys. Leave blank to run without bank linking.
PLAID_CLIENT_ID=
PLAID_SECRET=
