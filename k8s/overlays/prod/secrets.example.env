# Production secrets. Prefer a secret manager (External Secrets Operator,
# Sealed Secrets, or your cloud's CSI driver) over a file; if you do use this,
# keep secrets.env out of git (it is ignored) and out of CI logs.
DATABASE_URL=postgresql://USER:PASSWORD@your-managed-db-host:5432/spendly?schema=public&sslmode=require
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32 — encrypts 2FA secrets and bank tokens at rest
DATA_ENCRYPTION_KEY=
# SMTP connection URL (contains credentials, so it is a secret)
SMTP_URL=smtps://USER:PASSWORD@email-smtp.us-east-1.amazonaws.com:465
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
