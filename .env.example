# Copy to .env (git-ignored) and fill in. Generate secrets with:
#   openssl rand -base64 48
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32 — encrypts 2FA secrets and bank tokens at rest. Keep it safe.
DATA_ENCRYPTION_KEY=

# Plaid SANDBOX keys — https://dashboard.plaid.com/developers/keys
# Leave blank to run without bank linking.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
